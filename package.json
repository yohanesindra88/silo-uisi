{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https --experimental-https-key certificates/localhost-key.pem --experimental-https-cert certificates/localhost.pem -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:excel": "npx tsx prisma/seed-excel.ts",
    "excel:generate": "npx tsx prisma/excel/generate-excel-templates.ts",
    "db:studio": "prisma studio",
    "media:variants": "tsx scripts/gen-variants.ts",
    "media:check": "tsx scripts/gen-variants.ts --check",
    "prebuild": "npm run media:variants",
    "predev": "npm run media:variants",
    "postinstall": "prisma generate",
    "media:gc": "tsx scripts/gc-media.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@types/aos": "^3.0.8",
    "@types/react-simple-maps": "^3.0.6",
    "aos": "^2.3.4",
    "bcryptjs": "^3.0.3",
    "cobe": "^2.0.1",
    "jose": "^6.2.11",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.30.0",
    "next": "^16.3.5",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^6.3.289",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-globe.gl": "^2.38.0",
    "react-pageflip": "^2.0.3",
    "react-simple-maps": "^3.0.0",
    "sharp": "^0.35.4",
    "three": "^0.185.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^6.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
