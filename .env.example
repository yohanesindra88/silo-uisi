# =============================================================================
# SILO UISI — konfigurasi deployment produksi
#
#   cp .env.example .env  &&  chmod 600 .env
#
# File .env TIDAK boleh di-commit (sudah tercakup .gitignore & .dockerignore).
# =============================================================================

# --- Timezone untuk semua container -----------------------------------------
TZ=Asia/Jakarta

# --- Database ----------------------------------------------------------------
# Kredensial ini dipakai saat volume pgdata pertama kali dibuat. Mengubahnya
# setelah itu TIDAK mengubah password di database yang sudah ada.
POSTGRES_USER=silo
POSTGRES_DB=silo_uisi
# Bangkitkan dengan: openssl rand -base64 32
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_YANG_KUAT

# --- Keamanan aplikasi -------------------------------------------------------
# WAJIB diganti. src/utils/jwt.ts punya fallback hardcoded yang hanya layak
# untuk development — jika JWT_SECRET kosong, siapa pun yang membaca repo ini
# bisa menempa token login untuk role apa pun.
# Bangkitkan dengan: openssl rand -base64 48
JWT_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER

# --- Cloudflare Tunnel -------------------------------------------------------
# Ambil dari: Cloudflare Zero Trust > Networks > Tunnels > (tunnel Anda) >
# Configure > pilih Docker — token ada di dalam perintah yang ditampilkan,
# setelah flag `--token`.
# Public hostname tunnel diarahkan ke service: http://app:3000
CLOUDFLARE_TUNNEL_TOKEN=

# --- Cloudinary (server-side) ------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=
# Alternatif ringkas: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# --- Cloudinary (client-side) ------------------------------------------------
# PERHATIAN: nilai NEXT_PUBLIC_* di-inline ke bundle browser saat `next build`.
# Mengubahnya mengharuskan rebuild image: docker compose up -d --build app
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=zjnwhofb
NEXT_PUBLIC_CLOUDINARY_FOLDER=Aethera SILO UISI 2026

# --- Penyimpanan media -------------------------------------------------------
# Direktori di HOST tempat berkas upload disimpan (bind mount ke container).
# Wajib ada dan dimiliki uid 1000 sebelum `docker compose up` pertama:
#   sudo mkdir -p /srv/silo/media && sudo chown -R 1000:1000 /srv/silo/media
MEDIA_HOST_DIR=/srv/silo/media
# Batas ukuran satu berkas upload, dalam byte (default 8 MiB).
MEDIA_MAX_BYTES=8388608

# --- Migrasi & seeding -------------------------------------------------------
# Set true HANYA saat ingin mengisi data awal, lalu kembalikan ke false.
# Seeder menghapus/menimpa sebagian data — jangan biarkan true di produksi.
RUN_SEED=false

# --- Batas resource (opsional) ----------------------------------------------
APP_MEMORY_LIMIT=1g
POSTGRES_MEMORY_LIMIT=1g
CLOUDFLARED_MEMORY_LIMIT=256m
