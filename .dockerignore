# --- VCS & editor ---
.git
.gitignore
.vscode
.idea

# --- Dependencies & build output (rebuilt inside the image) ---
node_modules
.next
out
build
dist
*.tsbuildinfo
next-env.d.ts

# --- Secrets: never bake these into an image layer ---
.env
.env.*
!.env.example
certificates
*.pem
*.key

# --- Generated media variants (dibangkitkan ulang saat build via prebuild) ---
public/_m

# --- Local tooling / docs not needed at build time ---
Dockerfile
docker-compose*.yml
.dockerignore
README.md
DEPLOYMENT.md
walkthrough*.md
scratch
coverage
.vercel
resize_images.py

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
